      "criterion_hash": "$CRITERION_HASH",
      "plant": { "model_hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "mutation_list_hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" },
      "engine": { "name": "hand", "version": "1", "build": "hand-entry-1" },
      "run": { "status": "completed" },
      "observed": { "quantity": "core inlet flow", "unit": "kg/s", "window": { "from": 0, "to": 600, "unit": "s" }, "min": 5.2, "max": 9 }
