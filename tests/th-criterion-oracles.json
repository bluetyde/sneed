{
  "note": "Hand-worked cases for stage T0 of the thermal-hydraulic link (docs/plans/14-th-link.md). Every expected status and reason was decided by reading the rule, not by running the code. The base criterion: the quantity 'core inlet flow' must be ABOVE 5 kg/s THROUGHOUT 0 to 600 s. Patches are dotted paths set on the base before the case runs. '$CRITERION_HASH' stands for the hash of the case's own criterion and '$BASE_CRITERION_HASH' for the hash of the unpatched base criterion; the test fills both in.",
  "base": {
    "criterion": {
      "schema": { "id": "sneed.th-criterion", "version": 1 },
      "criterion": { "id": "flow-ok", "name": "Flow is kept (example)", "description": "Example criterion for tests.", "synthetic": true, "created": "2026-10-07T00:00:00Z", "updated": "2026-10-07T00:00:00Z" },
      "applies_to": { "event_tree": { "name": "tree-a", "tree_hash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" }, "heading": "H1" },
