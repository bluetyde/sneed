      { "name": "found: the one for H2 is found when asked for H2", "tree": "tree-a", "heading": "H2", "others": ["for-h2"], "dropBase": true, "expect": "ok" },
      { "name": "refused, and the invalid one is counted: the only criterion for H1 is not valid", "tree": "tree-a", "heading": "H1", "others": ["broken-for-h1"], "dropBase": true, "expect": "E_TH_NO_CRITERION", "messageHas": "1 criterion document was not valid" },
      { "name": "found: an invalid second one for H1 does not count as a second", "tree": "tree-a", "heading": "H1", "others": ["broken-for-h1"], "expect": "ok" }
