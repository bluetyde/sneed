{
  "name": "sneed",
  "private": true,
  "version": "0.0.0",
  "description": "SNEED (formerly PRA & Reliability Studio): fault-tree teaching tool. Native model core.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:engine": "vitest run tests/engine",
    "test:all": "vitest run",
    "runtime": "tsx scripts/runtime.ts",
    "server": "tsx src/server/main.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "gen:seed-oracles": "tsx scripts/gen-seed-oracles.ts",
    "e2e": "vite build && playwright test -c e2e/playwright.config.ts",
    "build": "tsc --noEmit && vite build",
    "dev:server": "tsx src/server/main.ts --dev",
    "start": "vite build && tsx src/server/main.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.63",
    "@types/node": "^24.19.1",
    "axe-core": "^4.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "fast-xml-parser": "^5.11.2"
  }
}
