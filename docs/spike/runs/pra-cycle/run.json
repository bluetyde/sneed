{
  "cmd": [
    "wsl",
    "-d",
    "Ubuntu",
    "--exec",
    "env",
    "LD_LIBRARY_PATH=/root/pra-scram/build/lib/scram:/root/pra-scram/env-old/lib",
    "/root/pra-scram/build/bin/scram",
    "--bdd",
    "--probability",
    "true",
    "<repo>/docs/spike/inputs/pra-cycle.xml",
    "-o",
    "<repo>/docs/spike/runs/pra-cycle/report.xml"
  ],
  "exit": 1,
  "stdout": "",
  "stderr": "scram::mef::CycleError\n\n\nDetected a cycle in TOP gate:\nTOP->G2->TOP\n",
  "report_exists": false
}